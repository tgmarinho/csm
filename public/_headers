## Cabeçalhos - CSM Psicologia (Netlify)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# HTML: sempre revalida (conteúdo pode mudar)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS são versionados por hash de conteúdo em ?v= (ver scripts/stamp-assets.mjs,
# rodado no build da Netlify), então cada versão é uma URL nova e immutable é
# seguro: cache de 1 ano, visitas repetidas instantâneas, e a URL muda sozinha
# quando o arquivo muda. NÃO volte a servir sem versão, ou devices ficam presos
# na versão antiga por até 1 ano.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
# Imagens não são versionadas; cache curto com revalidação em segundo plano
# evita logo/preview presos em versão antiga sem perder performance.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Arquivos para máquinas
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
